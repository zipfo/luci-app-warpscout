
config warpscout 'main'
	option binary '/usr/bin/warpscout'
	option version '0.16.1'
	option account '/etc/warpscout/account.json'
	option auto_update '0'
	option update_url ''
	option jobs '4'
	option caps_ttl '60'

config scanprofile 'default'
	option proto 'awg'
	option tun_ping '1'
	option speed '0'
	option best_by 'ping'
	option sample '5'
	option timeout '2'
	option ipv6 '0'
	option full '0'
	option port ''
	option sweep_ports ''
	option nodes ''
	option countries ''
	option exclude_nodes 'DME'
	option exclude_countries ''
	option targets ''
	option gen_i1 ''
	option i1_sni ''
	option gen_junk '0'
	option jc ''
	option jmin ''
	option jmax ''
	option i1 ''
	option masque_sni ''
	option masque_attempts ''
	option table_off '0'
	option mtu ''
	option dns ''

config job 'nightly'
	option enabled '0'
	option profile 'default'
	option cron '0 4 * * *'
	option action 'update_tunnels'
	option catchup '1'
	option jitter '300'

config socks 'socks'
	option enabled '0'
	option endpoint ''
	option proto 'awg'
	option listen '127.0.0.1'
	option port '1080'
	option allow_lan '0'
	option auto_rescan '0'
